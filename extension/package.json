{
  "name": "@atlas/firefox",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "description": "Firefox prototype adapter for AtlasCore",
  "scripts": {
    "build": "npm --prefix ../packages/core run build && tsc -p tsconfig.json && node build.mjs",
    "typecheck": "npm --prefix ../packages/core run build && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:firefox": "npm run build && python scripts/firefox-e2e.py",
    "test:public-sites": "npm run build && python scripts/firefox-public-sites.py",
    "release:build": "node scripts/release.mjs build",
    "release:validate": "node scripts/release.mjs validate",
    "release:sign": "node scripts/release.mjs sign",
    "release:verify-signed": "node scripts/release.mjs verify-signed",
    "release:version": "node scripts/release.mjs version"
  },
  "dependencies": {
    "@atlas/core": "file:../packages/core",
    "tldts": "7.4.16"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.1",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "typescript": "6.0.3",
    "web-ext": "10.7.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "fx-runner": {
      "shell-quote": "1.12.0"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
