{
  "manifest_version": 2,
  "name": "Atlas",
  "version": "0.3.2",
  "description": "Intentional top-level web access, decided by AtlasCore.",
  "browser_specific_settings": {
    "gecko": {
      "id": "atlas-development@atlas.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "icons": {
    "48": "ui/atlas.svg",
    "96": "ui/atlas.svg"
  },
  "browser_action": {
    "default_title": "Atlas status and shortcuts",
    "default_popup": "ui/popup.html",
    "default_icon": "ui/atlas.svg",
    "default_area": "navbar"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "journey-indicator.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "ui/index.html",
    "open_in_tab": true
  },
  "chrome_settings_overrides": {
    "homepage": "ui/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "ui/index.html"
  },
  "incognito": "not_allowed",
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
}
